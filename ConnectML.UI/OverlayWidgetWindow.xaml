<Window x:Class="ConnectML.UI.OverlayWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ConnectML Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Focusable="False"
        Background="{x:Null}"
        ShowActivated="False">

    <Window.Resources>
        <!-- Storyboard de Pulso GPU em Amarelo para Estado 'Aguardando Medição' -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OverlayBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.30" To="1.0" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StateDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1.0" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    
    <Grid x:Name="RootOverlayGrid" Background="{x:Null}">
        <!-- Borda Perimetral (IsHitTestVisible="False" garante 100% de passagem de cliques ao fundo) -->
        <Border x:Name="OverlayBorder"
                BorderBrush="#F59E0B"
                BorderThickness="3"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        <!-- Contêiner da Aba (IsHitTestVisible="False" para a área vazia) -->
        <Grid x:Name="DockContainer" Background="{x:Null}" IsHitTestVisible="False">
            <!-- Aba Flutuante do Widget (IsHitTestVisible="True" apenas na aba) -->
            <Border x:Name="OverlayTabContainer"
                    IsHitTestVisible="True"
                    Background="#1E293B"
                    BorderBrush="#F59E0B"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,8,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Padding="14,6,12,6"
                    Cursor="Hand"
                    MouseLeftButtonDown="OverlayTabContainer_MouseLeftButtonDown"
                    MouseMove="OverlayTabContainer_MouseMove"
                    MouseLeftButtonUp="OverlayTabContainer_MouseLeftButtonUp">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TabTranslateTransform" X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>

                <StackPanel x:Name="TabContentPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Indicador Circular de Estado -->
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    
                    <!-- Texto de Estado Principal -->
                    <TextBlock x:Name="TxtOverlayStatus"
                               Text="Aguardando Medição"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center"/>

                    <!-- Separador Sutil (Horizontal ou Vertical conforme orientação) -->
                    <Rectangle x:Name="TabSeparator" Width="1" Height="14" Fill="#475569" Margin="10,0,8,0" VerticalAlignment="Center"/>

                    <!-- Botão Abrir Janela Principal -->
                    <Button x:Name="BtnRestoreMainWindow"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2"
                            Cursor="Hand"
                            ToolTip="Abrir janela principal"
                            Click="BtnRestoreMainWindow_Click"
                            PreviewMouseLeftButtonDown="BtnRestoreMainWindow_PreviewMouseLeftButtonDown"
                            VerticalAlignment="Center">
                        <StackPanel x:Name="BtnContentPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Path Fill="#94A3B8" Data="M19,19H5V5h7V3H5A2,2 0 0,0 3,5v14a2,2 0 0,0 2,2h14a2,2 0 0,0 2-2v-7h-2V19z M14,3v2h3.59l-9.83,9.83l1.41,1.41L19,6.41V10h2V3H14z"/>
                            </Viewbox>
                            <TextBlock x:Name="TxtBtnRestore" Text="Abrir" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
