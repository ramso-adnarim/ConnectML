<Window x:Class="ConnectML.UI.OverlayWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ConnectML Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        Background="{x:Null}"
        ShowActivated="False">

    <Window.Resources>
        <!-- Storyboard de Pulso GPU em Amarelo para Estado 'Aguardando Medição' -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OverlayBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.30" To="1.0" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StateDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1.0" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    
    <Grid x:Name="RootOverlayGrid" Background="{x:Null}">
        <!-- Borda Perimetral (IsHitTestVisible="False" garante 100% de passagem de cliques ao fundo) -->
        <Border x:Name="OverlayBorder"
                BorderBrush="#F59E0B"
                BorderThickness="3"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        <!-- Contêiner da Aba (Background="{x:Null}" permite passagem de cliques na área vazia, enquanto os filhos sólidos recebem cliques) -->
        <Grid x:Name="DockContainer" Background="{x:Null}">
            <!-- Aba Flutuante do Widget -->
            <Border x:Name="OverlayTabContainer"
                    Background="#1E293B"
                    BorderBrush="#F59E0B"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,8,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Padding="12,6,10,6"
                    Cursor="Hand"
                    MouseLeftButtonDown="OverlayTabContainer_MouseLeftButtonDown"
                    MouseMove="OverlayTabContainer_MouseMove"
                    MouseLeftButtonUp="OverlayTabContainer_MouseLeftButtonUp">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TabTranslateTransform" X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>

                <StackPanel x:Name="TabContentPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. Manipulador de Arraste (Grip Handle com pontos verticais) -->
                    <Grid x:Name="GripHandle" Cursor="SizeAll" Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Clique e arraste para reposicionar a aba">
                        <Viewbox x:Name="GripViewbox" Width="10" Height="14" VerticalAlignment="Center">
                            <Path Fill="#64748B" Stretch="Uniform"
                                  Data="M4,2A1.5,1.5 0 1,1 4,5A1.5,1.5 0 0,1 4,2M10,2A1.5,1.5 0 1,1 10,5A1.5,1.5 0 0,1 10,2M4,8A1.5,1.5 0 1,1 4,11A1.5,1.5 0 0,1 4,8M10,8A1.5,1.5 0 1,1 10,11A1.5,1.5 0 0,1 10,8M4,14A1.5,1.5 0 1,1 4,17A1.5,1.5 0 0,1 4,14M10,14A1.5,1.5 0 1,1 10,17A1.5,1.5 0 0,1 10,14Z"/>
                        </Viewbox>
                    </Grid>

                    <!-- 2. Indicador Circular de Estado -->
                    <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    
                    <!-- 3. Texto de Estado Principal -->
                    <TextBlock x:Name="TxtOverlayStatus"
                               Text="Aguardando Medição"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform x:Name="TextRotateTransform" Angle="0"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>

                    <!-- 4. Separador 1 -->
                    <Rectangle x:Name="TabSeparator1" Width="1" Height="14" Fill="#475569" Margin="10,0,8,0" VerticalAlignment="Center"/>

                    <!-- 5. Botão Configurações do HUD (Engrenagem) -->
                    <Button x:Name="BtnOverlaySettings"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="3"
                            Cursor="Hand"
                            ToolTip="Configurações do Widget HUD"
                            Click="BtnOverlaySettings_Click"
                            PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"
                            VerticalAlignment="Center">
                        <Viewbox x:Name="IconSettingsViewbox" Width="14" Height="14" VerticalAlignment="Center">
                            <Path x:Name="PathSettingsIcon" Fill="#94A3B8" Stretch="Uniform"
                                  Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                        </Viewbox>
                    </Button>

                    <!-- 6. Separador 2 -->
                    <Rectangle x:Name="TabSeparator2" Width="1" Height="14" Fill="#475569" Margin="6,0,8,0" VerticalAlignment="Center"/>

                    <!-- 7. Botão Abrir Janela Principal -->
                    <Button x:Name="BtnRestoreMainWindow"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2"
                            Cursor="Hand"
                            ToolTip="Abrir janela principal"
                            Click="BtnRestoreMainWindow_Click"
                            PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"
                            VerticalAlignment="Center">
                        <StackPanel x:Name="BtnContentPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconRestoreViewbox" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Path Fill="#94A3B8" Data="M19,19H5V5h7V3H5A2,2 0 0,0 3,5v14a2,2 0 0,0 2,2h14a2,2 0 0,0 2-2v-7h-2V19z M14,3v2h3.59l-9.83,9.83l1.41,1.41L19,6.41V10h2V3H14z"/>
                            </Viewbox>
                            <TextBlock x:Name="TxtBtnRestore" Text="Abrir" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
